# Copy this file to .env and fill in real values. Never commit .env.

# --- Bus Open Data Service (free registration at https://www.bus-data.dft.gov.uk/) ---
BODS_API_KEY=your_free_bods_api_key_here

# --- PostgreSQL (Gold warehouse) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bus_fare_cap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_locally

# --- MinIO (S3-compatible object storage for Bronze/Silver) ---
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_locally
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver

# --- Open-Meteo: no key required ---

# --- Airflow (only needed once you enable the airflow service) ---
AIRFLOW_UID=50000
